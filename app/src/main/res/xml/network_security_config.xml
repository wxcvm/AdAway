<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        These trust anchors apply only to AdAway's own network stack.
        They do not install certificates or change other applications' trust.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!--
        Local health, statistics and management use both IP families.
        Permit only their literal loopback hosts; public cleartext remains off.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>

    <!--
        For the HTTPS cert-installation check (https://localhost/internal-test):
        trust both system-level and user-level CAs so the per-device certificate
        can be installed at either level and be correctly detected.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
