<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/pref_root_title">

    <PreferenceCategory app:title="@string/pref_hosts_installation">
        <Preference
            app:key="@string/pref_open_hosts_key"
            app:persistent="false"
            app:title="@string/pref_root_open_hosts" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_never_reboot_def"
            app:key="@string/pref_never_reboot_key"
            app:title="@string/pref_never_reboot" />
    </PreferenceCategory>

    <PreferenceCategory
        app:summary="@string/pref_hosts_redirection_summary"
        app:title="@string/pref_hosts_redirection">
        <EditTextPreference
            app:defaultValue="@string/pref_redirection_ipv4_def"
            app:dialogLayout="@layout/pref_edittext_dialog"
            app:key="@string/pref_redirection_ipv4_key"
            app:title="@string/pref_redirection_ipv4" />
        <EditTextPreference
            app:defaultValue="@string/pref_redirection_ipv6_def"
            app:dialogLayout="@layout/pref_edittext_dialog"
            app:enabled="false"
            app:key="@string/pref_redirection_ipv6_key"
            app:title="@string/pref_redirection_ipv6" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_webserver">
        <Preference
            app:persistent="false"
            app:selectable="false"
            app:summary="@string/pref_webserver_summary" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_webserver_enabled_def"
            app:key="@string/pref_webserver_enabled_key"
            app:title="@string/pref_webserver_enabled" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:key="@string/pref_webserver_test_key"
            app:persistent="false"
            app:summary="@string/pref_webserver_state_checking"
            app:title="@string/pref_webserver_test" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:key="@string/pref_webserver_certificate_key"
            app:persistent="false"
            app:title="@string/pref_webserver_certificate" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:key="@string/pref_webserver_block_image_key"
            app:persistent="false"
            app:summary="@string/pref_webserver_block_image_summary"
            app:title="@string/pref_webserver_block_image" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:key="@string/pref_webserver_stats_key"
            app:persistent="false"
            app:summary="@string/pref_webserver_stats_summary"
            app:title="@string/pref_webserver_stats" />
        <PreferenceCategory
            app:key="@string/pref_block_reply_category_key"
            app:summary="@string/pref_block_reply_summary"
            app:title="@string/pref_block_reply_title">
            <ListPreference
                app:defaultValue="@string/pref_block_reply_mode_default"
                app:entries="@array/pref_block_reply_modes"
                app:entryValues="@array/pref_block_reply_mode_values"
                app:key="@string/pref_block_reply_mode_key"
                app:title="@string/pref_block_reply_mode" />
            <PreferenceScreen
                app:key="@string/pref_block_reply_advanced_key"
                app:title="@string/pref_block_reply_advanced">
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_images_key" app:summary="@string/pref_block_reply_images_summary" app:title="@string/pref_block_reply_images" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_scripts_key" app:summary="@string/pref_block_reply_scripts_summary" app:title="@string/pref_block_reply_scripts" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_styles_key" app:summary="@string/pref_block_reply_styles_summary" app:title="@string/pref_block_reply_styles" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_fonts_key" app:summary="@string/pref_block_reply_fonts_summary" app:title="@string/pref_block_reply_fonts" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_media_key" app:summary="@string/pref_block_reply_media_summary" app:title="@string/pref_block_reply_media" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_api_key" app:summary="@string/pref_block_reply_api_summary" app:title="@string/pref_block_reply_api" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_telemetry_key" app:summary="@string/pref_block_reply_telemetry_summary" app:title="@string/pref_block_reply_telemetry" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_structures_key" app:summary="@string/pref_block_reply_structures_summary" app:title="@string/pref_block_reply_structures" />
                <SwitchPreferenceCompat app:defaultValue="true" app:key="@string/pref_block_reply_ws_sse_key" app:summary="@string/pref_block_reply_ws_sse_summary" app:title="@string/pref_block_reply_ws_sse" />
            </PreferenceScreen>
        </PreferenceCategory>
    </PreferenceCategory>

</PreferenceScreen>
